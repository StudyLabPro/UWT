# UWT donations API — все переменные окружения (значения-примеры, НЕ секреты)

# Обязательно для приёма платежей: секретный ключ Stripe (sk_live_… / sk_test_…)
STRIPE_SECRET_KEY=

# Обязательно для учёта платежей: signing secret webhook-эндпоинта (whsec_…)
# Получить: Stripe Dashboard → Developers → Webhooks → Add endpoint
#   URL: https://uwt.xteam.pro/api/stripe/webhook
#   Событие: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# Необязательно: зафиксировать версию Stripe API (иначе версия аккаунта)
STRIPE_API_VERSION=

# Порт HTTP-сервера
PORT=8080

# Публичный базовый URL сайта (для success/cancel-редиректов Checkout)
UWT_PUBLIC_URL=https://uwt.xteam.pro

# Разрешённые Origin для CORS, через запятую (пусто = same-host)
UWT_ALLOWED_ORIGINS=https://uwt.xteam.pro

# Валюта и границы суммы (в минорных единицах: 100 = $1)
UWT_DONATION_CURRENCY=usd
UWT_DONATION_MIN_MINOR=100
UWT_DONATION_MAX_MINOR=500000

# Rate limit: окно (мс) и максимум запросов с одного IP за окно
UWT_DONATION_RATE_LIMIT_WINDOW_MS=60000
UWT_DONATION_RATE_LIMIT_MAX=30

# Путь JSONL-журнала подтверждённых донатов (в Docker — на volume /data)
DONATIONS_LOG_PATH=/data/donations.jsonl
